```

</div>

<!-- ================================================= -->

<!-- RECEIVE MODAL -->

<!-- ================================================= -->

<div
    id="receiveModal"
    class="modal"
>

```
<div class="modal-content">

    <button
        class="close"
        onclick="closeReceive()"
    >
        ×
    </button>


    <h2>
        Receive
        <span id="receiveCoin"></span>
    </h2>


    <div id="qrcode"></div>


    <div class="address-box">

        <input
            type="text"
            id="receiveAddress"
            readonly
        >


        <button
            onclick="copyAddress()"
        >
            Copy
        </button>

    </div>

</div>
```

</div>

<!-- ================================================= -->

<!-- SEND MODAL -->

<!-- ================================================= -->

<div
    id="sendModal"
    class="modal"
>

```
<div class="modal-content">

    <button
        class="close"
        onclick="closeSend()"
    >
        ×
    </button>


    <h2>
        Send
        <span id="sendCoin"></span>
    </h2>


    <form id="sendForm">


        <label>
            Destination address
        </label>


        <input
            type="text"
            id="destinationAddress"
            placeholder="Enter destination address"
            required
        >


        <label>
            Amount
        </label>


        <input
            type="number"
            id="sendAmount"
            placeholder="0.00000000"
            step="any"
            min="0"
            required
        >


        <label>
            Password (signature)
        </label>


        <input
            type="password"
            id="sendPassword"
            placeholder="Confirmez votre mot de passe"
            autocomplete="current-password"
        >


        <button
            type="submit"
            class="send-confirm"
        >
            Send
        </button>


    </form>

</div>


</div>

<!-- ================================================= -->

<!-- SCRIPTS -->

<!-- ================================================= -->

<script
    src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"
></script>

<script src="/js/matrix.js"></script>

<script
    src="/js/walletserver.js"
></script>

</body>

</html>
