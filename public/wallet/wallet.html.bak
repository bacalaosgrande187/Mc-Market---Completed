<!DOCTYPE html>

<html lang="fr">

<head>

<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<title>Wallet - Mc Market</title>

<link
    rel="icon"
    type="image/png"
    href="/images/mc-market-logo.png"
>

<link
    rel="stylesheet"
    href="/css/wallet.css"
>

</head>

<body>

<div class="wallet-container">

<!-- HEADER -->

<header class="wallet-header">

    <div>

        <h1>Portfolio</h1>

        <p id="username">
            Loading...
        </p>

    </div>


    <div style="display:flex; gap:10px; align-items:center;">

        <a
            href="/market.html"
            class="logout-btn"
            style="text-decoration:none; display:inline-block;"
        >
            Boutique
        </a>

        <button
            id="logoutBtn"
            class="logout-btn"
        >
            Déconnexion
        </button>

    </div>

</header>



<main>

    <div class="wallet-card">


        <!-- ================================================= -->
        <!-- BTC -->
        <!-- ================================================= -->

        <div class="crypto-row">

            <div class="crypto-info">

                <div class="crypto-icon btc">
                    ₿
                </div>

                <div>

                    <h2>Bitcoin</h2>

                    <span>BTC</span>

                </div>

            </div>


            <div class="balance">

                <strong id="btc-balance">
                    0.00000000
                </strong>

                <span>BTC</span>

            </div>


            <div class="swap-section">

                <input
                    type="number"
                    id="btc-swap-amount"
                    placeholder="Amount to Swap"
                    step="any"
                    min="0"
                >


                <select id="btc-swap-crypto">

                    <option value="ETH">ETH</option>
                    <option value="SOL">SOL</option>
                    <option value="LTC">LTC</option>
                    <option value="TRX">TRX</option>
                    <option value="DOGE">DOGE</option>
                    <option value="POL">POL</option>
                    <option value="USDC">USDC</option>
                    <option value="USDT">USDT</option>

                </select>


                <select id="btc-swap-dex">

                    <option value="1inch">
                        1inch
                    </option>

                    <option value="sushiswap">
                        SushiSwap
                    </option>

                    <option value="pancakeswap">
                        PancakeSwap
                    </option>

                </select>


                <div class="amount-receive">

                    <span>
                        Amount Receive
                    </span>

                    <strong id="btc-receive-amount">
                        0.00000000
                    </strong>

                </div>


                <button
                    onclick="swapCrypto('BTC')"
                >
                    Swap
                </button>

            </div>


            <div class="actions">

                <button
                    onclick="openReceive('BTC')"
                >
                    Receive
                </button>

                <button
                    onclick="openSend('BTC')"
                >
                    Send
                </button>

            </div>

        </div>



        <!-- ================================================= -->
        <!-- ETH -->
        <!-- ================================================= -->

        <div class="crypto-row">

            <div class="crypto-info">

                <div class="crypto-icon eth">
                    Ξ
                </div>

